# Copy to .env.local for development, or .env.production.local for your own build.
# Both local files are ignored by Git. Restart dev / rebuild production after edits.
# VITE_* values are public and embedded in browser assets. Never use backend secrets.
# Obtain your enabled Web SDK Key at https://console.meshstream.net/ and allow your origin.
VITE_MESHSTREAM_SDK_KEY=

# Optional: redirect localhost/127.0.0.1 to this hostname, retaining scheme and port.
# Leave empty for normal local use. This does not configure DNS or HTTPS.
VITE_P2PCDN_PUBLIC_HOST=
